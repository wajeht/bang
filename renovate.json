{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["github>wajeht/renovate-config"],
    "npmrc": "engine-strict=false\n",
    "npmrcMerge": true,
    "skipInstalls": false,
    "constraints": {
        "node": ">=26.1.0"
    },
    "packageRules": [
        {
            "description": "Upgrade the Vite+ stack with vp migrate using the versions bundled in the target release",
            "matchPackageNames": [
                "vite-plus",
                "@voidzero-dev/vite-plus-core",
                "vitest",
                "@vitest/coverage-v8",
                "@oxlint/plugins"
            ],
            "enabled": false
        }
    ]
}
